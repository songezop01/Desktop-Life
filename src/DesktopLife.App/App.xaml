<Application x:Class="DesktopLife.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Shared illustrated-companion palette. Control styles stay scoped to the console. -->
        <SolidColorBrush x:Key="PaperBrush" Color="#F8F3EE"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFDF9"/>
        <SolidColorBrush x:Key="CocoaBrush" Color="#69534F"/>
        <SolidColorBrush x:Key="MutedCocoaBrush" Color="#8B726D"/>
        <SolidColorBrush x:Key="RoseBrush" Color="#B97880"/>
        <SolidColorBrush x:Key="RoseSoftBrush" Color="#F5DBDD"/>
        <SolidColorBrush x:Key="LavenderBrush" Color="#797293"/>
        <SolidColorBrush x:Key="LavenderSoftBrush" Color="#EDE8F5"/>
        <SolidColorBrush x:Key="PeachSoftBrush" Color="#FAE8D6"/>
        <SolidColorBrush x:Key="OutlineBrush" Color="#ECDDD7"/>
    </Application.Resources>
</Application>
