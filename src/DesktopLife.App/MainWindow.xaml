<Window x:Class="DesktopLife.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:DesktopLife.App"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Life · 陪伴小屋" Width="860" Height="800" MinWidth="690" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PaperBrush}"
        Foreground="{StaticResource CocoaBrush}" FontFamily="Microsoft JhengHei UI, Segoe UI"
        FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True" Loaded="InitializeRuntimeDiagnosticsUi">
    <Window.Resources>
        <local:UiText x:Key="UiText"/>
        <DataTemplate x:Key="EnumLabel"><TextBlock Text="{Binding Converter={StaticResource UiText}}"/></DataTemplate>
        <Style x:Key="CompanionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource RoseSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource CocoaBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource RoseBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource CompanionButton}"/>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource CompanionButton}">
            <Setter Property="Background" Value="{StaticResource CocoaBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CocoaBrush}"/>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource CompanionButton}">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource CocoaBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource CocoaBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource RoseSoftBrush}"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource CocoaBrush}"/>
            <Setter Property="Margin" Value="0,6,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Slider"><Setter Property="Margin" Value="0,4,0,14"/></Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedCocoaBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource CocoaBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <ToggleButton x:Name="ExpandToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0"
                                              HorizontalContentAlignment="Stretch" Cursor="Hand" Padding="0,3">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <DockPanel>
                                        <TextBlock x:Name="Chevron" Text="＋" Foreground="{StaticResource RoseBrush}" FontSize="18" DockPanel.Dock="Right" Margin="12,0,0,0"/>
                                        <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" RecognizesAccessKey="True"
                                                          TextElement.FontSize="16" TextElement.FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Margin="0,16,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandContent" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Chevron" Property="Text" Value="－"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="26,22,26,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="4,0,4,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="VersionBanner" Text="DESKTOP LIFE  /  陪伴小屋" Foreground="{StaticResource RoseBrush}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock x:Name="CompanionTitle" Text="一起，把日子過得柔軟一點。" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,4"/>
                <TextBlock Text="栗子、女孩，還有新朋友邊牧犬。讓喜歡的陪伴留在桌面。" Style="{StaticResource Hint}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource RoseSoftBrush}" CornerRadius="16" Padding="14,8" VerticalAlignment="Top" Margin="16,5,0,0">
                <TextBlock Text="♡  小小的日常" Foreground="{StaticResource CocoaBrush}" FontSize="12"/>
            </Border>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,9,0">
            <StackPanel>
                <Border Style="{StaticResource Card}" Background="#FFF9F4" Padding="18,15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="今天，誰陪你？" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>
                        <TextBlock Text="輕點角色卡片，或選擇一起陪伴的朋友。" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                        <UniformGrid Columns="3" Margin="0,2,0,8">
                            <Border Background="{StaticResource PeachSoftBrush}" CornerRadius="15" Padding="8" Margin="0,0,8,0" Tag="Cat" Cursor="Hand" MouseLeftButtonUp="ChooseCompanionCard">
                                <StackPanel>
                                    <Border x:Name="CatPortraitHost" Height="80" Visibility="Collapsed"/>
                                    <TextBlock Text="栗子 · 橘貓" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="暖暖的小淘氣" Foreground="{StaticResource MutedCocoaBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource RoseSoftBrush}" CornerRadius="15" Padding="8" Margin="0,0,8,0" Tag="Girl" Cursor="Hand" MouseLeftButtonUp="ChooseCompanionCard">
                                <StackPanel>
                                    <Border x:Name="GirlPortraitHost" Height="80" Visibility="Collapsed"/>
                                    <TextBlock Text="女孩" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="溫柔的日常夥伴" Foreground="{StaticResource MutedCocoaBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource LavenderSoftBrush}" CornerRadius="15" Padding="8" Tag="BorderCollie" Cursor="Hand" MouseLeftButtonUp="ChooseCompanionCard">
                                <StackPanel>
                                    <Border x:Name="DogPortraitHost" Height="80" Visibility="Collapsed"/>
                                    <TextBlock Text="邊牧犬" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="開朗的新朋友" Foreground="{StaticResource MutedCocoaBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <ComboBox x:Name="PresenceOptions" SelectionChanged="ChangePresence" AutomationProperties.Name="桌面角色" Margin="0,0,0,2"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="給牠一點陪伴" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="BondStatus" Foreground="{StaticResource LavenderBrush}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="照顧對象" VerticalAlignment="Center" Margin="0,0,14,8"/>
                            <ComboBox Grid.Column="1" x:Name="CareTargetOptions" SelectionChanged="ChangeCareTarget" MaxWidth="260" HorizontalAlignment="Left" MinWidth="180" AutomationProperties.Name="目前照顧對象"/>
                        </Grid>
                        <WrapPanel>
                            <Button x:Name="FeedButton" Content="餵飯" Click="FeedPet" Style="{StaticResource PrimaryButton}"/>
                            <Button x:Name="StrokeButton" Content="摸摸" Click="StrokePet"/>
                            <Button x:Name="PlayButton" Content="陪玩" Click="PlayPet"/>
                            <Button x:Name="GroomButton" Content="梳理" Click="GroomPet"/>
                            <Button x:Name="RestButton" Content="休息" Click="RestPet" Background="{StaticResource LavenderSoftBrush}"/>
                        </WrapPanel>
                        <TextBlock x:Name="CareStatus" Text="點一下桌寵，也能給牠摸摸。" Style="{StaticResource Hint}" Margin="0,2,0,8"/>
                        <CheckBox x:Name="QuietMode" Content="安靜陪伴，讓牠休息，也陪你專心工作" Checked="QuietChanged" Unchecked="QuietChanged"/>
                        <WrapPanel Margin="0,5,0,0">
                            <TextBox x:Name="PetName" Width="170" MaxLength="16" Margin="0,0,8,8" AutomationProperties.Name="寵物名字"/>
                            <Button Content="取個名字" Click="RenamePet" Style="{StaticResource QuietButton}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Expander Header="我們的小回憶" IsExpanded="False">
                    <StackPanel>
                        <TextBlock x:Name="IdentityStatus" Text="牠正在慢慢形成自己的生活習慣。" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                        <TextBlock x:Name="Memories" TextWrapping="Wrap" LineHeight="25" Foreground="{StaticResource MutedCocoaBrush}"/>
                    </StackPanel>
                </Expander>
                <Expander Header="佈置牠的房間" IsExpanded="True">
                    <StackPanel>
                        <TextBlock Text="小屋樓層"/>
                        <ComboBox x:Name="HouseFloors" SelectionChanged="ChangeHouseFloors"/>
                        <TextBlock x:Name="HouseStatus" Style="{StaticResource Hint}"/>
                        <Button Content="依樓層整理家具" Click="ArrangeFurniture" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
                        <TextBlock Text="放一件家具，讓牠慢慢發現新的生活角落。" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                        <WrapPanel><ComboBox x:Name="FurnitureOptions" ItemTemplate="{StaticResource EnumLabel}" Width="190" Margin="0,0,8,8"/><Button Content="放置家具／玩具" Click="AddFurniture"/></WrapPanel>
                        <CheckBox x:Name="EditRoom" Content="佈置模式：拖曳家具，右鍵收起" Checked="EditRoomChanged" Unchecked="EditRoomChanged"/>
                        <TextBlock x:Name="RoomStatus" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Expander>
                <Expander Header="顯示與桌面設定">
                    <StackPanel>
                        <TextBlock Text="寵物活動螢幕"/><ComboBox x:Name="DisplayOptions" DisplayMemberPath="Label" SelectionChanged="ChangeDisplay"/>
                        <TextBlock x:Name="DisplayStatus" Style="{StaticResource Hint}"/>
                        <TextBlock Text="角色、作品與玩具的顯示層級" Margin="0,14,0,0"/>
                        <ComboBox x:Name="Priorities" ItemTemplate="{StaticResource EnumLabel}" SelectionChanged="ChangePresentation"/>
                        <TextBlock Text="低層級位於應用程式下方，視窗還原或最小化時會露出桌寵。最高層級受 Windows 獨佔全螢幕與安全桌面限制。" Style="{StaticResource Hint}"/>
                        <TextBlock Text="關閉陪伴小屋視窗時" Margin="0,14,0,0"/><ComboBox x:Name="CloseOptions" ItemTemplate="{StaticResource EnumLabel}" SelectionChanged="ChangeCloseBehavior"/>
                        <ComboBox x:Name="Appearances" Visibility="Collapsed" ItemTemplate="{StaticResource EnumLabel}" SelectionChanged="ChangePresentation"/>
                        <Separator Margin="0,6,0,14" Background="{StaticResource OutlineBrush}"/>
                        <CheckBox x:Name="EnableDesktopIcons" Content="允許桌寵移動真實快捷圖示（先備份原始排列）" Checked="DesktopIconsChanged" Unchecked="DesktopIconsChanged"/>
                        <WrapPanel><Button Content="與快捷圖示互動一次" Click="PlayWithShortcut" Style="{StaticResource QuietButton}"/><Button Content="更新排列備份" Click="UpdateDesktopIconBackup" Style="{StaticResource QuietButton}"/><Button Content="恢復桌面圖示排列" Click="RestoreDesktopIcons" Style="{StaticResource QuietButton}"/></WrapPanel>
                        <TextBlock x:Name="IconStatus" Text="圖示互動預設關閉；啟用後備份排列，正常退出時嘗試恢復。" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </Expander>
                <Expander Header="聲音與音量">
                    <StackPanel>
                        <TextBlock Text="音效包"/><ComboBox x:Name="SoundPacks" DisplayMemberPath="Name" SelectionChanged="SelectSoundPack"/>
                        <WrapPanel><Button Content="匯入音效包資料夾" Click="ImportSoundPack" Style="{StaticResource QuietButton}"/><Button x:Name="RemoveSoundPackButton" Content="移除已匯入音效包" Click="RemoveSoundPack" Style="{StaticResource QuietButton}"/></WrapPanel>
                        <TextBlock x:Name="SoundPackStatus" Style="{StaticResource Hint}" Margin="0,2,0,6"/>
                        <CheckBox x:Name="MuteAudio" Content="靜音" Checked="ChangeAudio" Unchecked="ChangeAudio"/>
                        <TextBlock Text="整體音量（安靜陪伴模式也會靜音）"/><Slider x:Name="AudioVolume" Minimum="0" Maximum="100" ValueChanged="ChangeAudio" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="整體音量"/>
                        <TextBlock Text="貓咪音效"/><Slider x:Name="CatVolume" Minimum="0" Maximum="100" ValueChanged="ChangeAudioCategory" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="貓咪音效音量"/>
                        <TextBlock Text="玩具音效"/><Slider x:Name="ToyVolume" Minimum="0" Maximum="100" ValueChanged="ChangeAudioCategory" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="玩具音效音量"/>
                        <TextBlock Text="環境音效（目前沒有環境音源）" Style="{StaticResource Hint}"/><Slider x:Name="AmbientVolume" IsEnabled="False" Minimum="0" Maximum="100" ValueChanged="ChangeAudioCategory" Width="260" HorizontalAlignment="Left"/>
                        <WrapPanel><Button Content="試聽貓叫" Click="PreviewCatSound" Style="{StaticResource QuietButton}"/><Button Content="試聽呼嚕" Click="PreviewPurrSound" Style="{StaticResource QuietButton}"/><Button Content="試聽鈴鐺" Click="PreviewBellSound" Style="{StaticResource QuietButton}"/></WrapPanel>
                    </StackPanel>
                </Expander>
                <Expander Header="作品與自主活動">
                    <WrapPanel>
                        <Button Content="保留作品" Click="KeepArt" Style="{StaticResource QuietButton}"/>
                        <Button Content="隱藏／顯示作品" Click="ToggleArt" Style="{StaticResource QuietButton}"/>
                        <Button Content="清除作品" Click="ClearArt" Style="{StaticResource QuietButton}"/>
                        <Button Content="恢復自動活動" Click="AutoPet" Style="{StaticResource QuietButton}"/>
                    </WrapPanel>
                </Expander>
                <Expander Header="存檔與備份">
                    <StackPanel>
                        <TextBlock x:Name="StorageStatus" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                        <WrapPanel><Button Content="匯出寵物存檔" Click="ExportPetSave" Style="{StaticResource QuietButton}"/><Button Content="匯入存檔（下次啟動套用）" Click="ImportPetSave" Style="{StaticResource QuietButton}"/></WrapPanel>
                    </StackPanel>
                </Expander>
                <Expander Header="進階／診斷" IsExpanded="False" Background="#F4EFEC">
                    <StackPanel>
                        <TextBlock Text="程式內檢查" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>
                        <TextBlock Text="使用獨立測試資料檢查三位角色與小屋。測試期間正式場景暫停，完成後恢復；控制台收進托盤也會繼續。" Style="{StaticResource Hint}" Margin="0,0,0,9"/>
                        <WrapPanel>
                            <Button x:Name="RuntimeShortTestButton" Content="短測 10 分鐘" Click="StartRuntimeShortTest" IsEnabled="False" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="執行程式內短測"/>
                            <Button x:Name="RuntimeLongTestButton" Content="長測 2 小時" Click="StartRuntimeLongTest" IsEnabled="False" AutomationProperties.Name="執行程式內長測"/>
                            <Button x:Name="RuntimeStopTestButton" Content="停止並保留報告" Click="StopRuntimeTest" IsEnabled="False" Style="{StaticResource QuietButton}"/>
                            <Button x:Name="RuntimeViewReportButton" Content="查看上次報告" Click="ViewRuntimeTestReport" IsEnabled="False" Style="{StaticResource QuietButton}"/>
                        </WrapPanel>
                        <TextBlock x:Name="RuntimeTestStatus" Text="尚未執行程式內檢查。" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2,0,7"/>
                        <ProgressBar x:Name="RuntimeTestProgress" Minimum="0" Maximum="100" Height="8" Margin="0,0,0,8" Foreground="{StaticResource RoseBrush}" Background="{StaticResource RoseSoftBrush}" BorderThickness="0"/>
                        <TextBlock x:Name="RuntimeTestDetails" Style="{StaticResource Hint}" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock Text="這是安裝程式的執行檢查；不包含開發時的建置、單元測試與 Standard／Full 發行驗證。主場景時間之外，另需啟動及保存核對時間。" Style="{StaticResource Hint}" FontSize="11" Margin="0,0,0,16"/>
                        <Separator Margin="0,0,0,14"/>
                        <TextBlock x:Name="BrainStatus" Foreground="{StaticResource LavenderBrush}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="PersonalityStatus" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                        <Expander Header="習慣與創作偏好" Padding="12">
                            <StackPanel><TextBlock x:Name="ActionScores" TextWrapping="Wrap"/><TextBlock x:Name="StyleStatus" TextWrapping="Wrap"/><TextBlock x:Name="LearningStatus" TextWrapping="Wrap"/><TextBlock x:Name="PreferenceStatus" TextWrapping="Wrap"/></StackPanel>
                        </Expander>
                        <TextBlock Text="生理狀態" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FeedingStatus" Style="{StaticResource Hint}" Margin="0,8,0,12"/>
                        <ItemsControl x:Name="HomeostasisRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"/>
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Value, Mode=OneWay}" Height="7" VerticalAlignment="Center" Foreground="{StaticResource RoseBrush}" Background="{StaticResource RoseSoftBrush}" BorderThickness="0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:F2}}" HorizontalAlignment="Right" Foreground="{StaticResource LavenderBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="數值 0–100；飢餓、無聊、孤單、疲勞越高代表需求越高。" Style="{StaticResource Hint}" Margin="0,12,0,10"/>
                        <Button Content="忘記家具習慣" Click="ForgetFurnitureHabits" HorizontalAlignment="Left" Style="{StaticResource QuietButton}"/>
                        <TextBlock Text="手動行為預覽" Margin="0,6,0,0"/><ComboBox x:Name="Actions" ItemTemplate="{StaticResource EnumLabel}" Width="190" HorizontalAlignment="Left" SelectionChanged="SelectAction"/>
                        <StackPanel Visibility="Collapsed"><TextBlock x:Name="SensorStatus"/><ItemsControl x:Name="SensorRows"/></StackPanel>
                    </StackPanel>
                </Expander>
                <TextBlock x:Name="SaveStatus" Text="生理狀態已載入；每 60 秒與正常關閉時保存。" Style="{StaticResource Hint}" FontSize="11" Margin="5,0,5,5"/>
                <TextBlock x:Name="SettingsText" Style="{StaticResource Hint}" FontSize="11" Margin="5,0,5,12"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{StaticResource PaperBrush}" Padding="4,15,4,0">
            <StackPanel>
                <WrapPanel>
                    <Button Content="顯示角色" Click="ShowPet" Style="{StaticResource PrimaryButton}" Padding="13,7"/>
                    <Button Content="隱藏角色" Click="HidePet" Style="{StaticResource QuietButton}"/>
                    <Button Content="重設位置" Click="ResetPet" Style="{StaticResource QuietButton}"/>
                    <Button Content="暫停／恢復自主行為" Click="PauseAi" Background="{StaticResource LavenderSoftBrush}" Padding="13,7"/>
                </WrapPanel>
                <TextBlock x:Name="HitStatus" Text="拖曳可抱起桌寵，放開就落地；輕點給牠摸摸。也可以拖球邀牠玩。" Style="{StaticResource Hint}" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
