<Window x:Class="DesktopLife.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:DesktopLife.App" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Desktop Life · 陪伴小屋" Width="790" Height="730" MinWidth="650" MinHeight="500" WindowStartupLocation="CenterScreen" Background="#F6F1E9" Foreground="#3E4541">
 <Window.Resources>
 <Style TargetType="Button"><Setter Property="Background" Value="#E5EFE7"/><Setter Property="Foreground" Value="#315C4A"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
<local:UiText x:Key="UiText"/><DataTemplate x:Key="EnumLabel"><TextBlock Text="{Binding Converter={StaticResource UiText}}"/></DataTemplate></Window.Resources>
 <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="DESKTOP LIFE  /  陪伴房間 0.6" Foreground="#5D826B" FontSize="12"/><TextBlock x:Name="CompanionTitle" Text="一隻小寵物，一起過日子。" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="牠會餓、會睏，也會慢慢記得你的溫柔。" Foreground="#747B73"/></StackPanel>
  <Border Grid.Row="1" Margin="0,20" Padding="20" CornerRadius="12" Background="#FFFDFA"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="今天，想怎麼陪牠？" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock x:Name="BondStatus" Margin="0,8,0,14" Foreground="#62846D"/>
   <WrapPanel><Button Content="餵飯飯" Click="FeedPet"/><Button Content="摸摸頭" Click="StrokePet"/><Button Content="一起玩球" Click="PlayPet"/><Button Content="梳理毛毛" Click="GroomPet"/><Button Content="哄牠睡覺" Click="RestPet"/></WrapPanel>
   <TextBlock x:Name="CareStatus" Text="點一下桌寵，也能給牠摸摸。" Foreground="#717970" Margin="0,4,0,12" TextWrapping="Wrap"/>
   <CheckBox x:Name="QuietMode" Content="安靜陪伴：讓牠休息，專心陪你工作" Checked="QuietChanged" Unchecked="QuietChanged" Margin="0,0,0,16"/>
   <WrapPanel><TextBox x:Name="PetName" Width="150" MaxLength="16" Padding="8,5" Margin="0,0,8,6"/><Button Content="取個名字" Click="RenamePet"/></WrapPanel>
   <Expander Header="我們的小回憶" IsExpanded="True" Margin="0,8,0,18"><TextBlock x:Name="Memories" TextWrapping="Wrap" LineHeight="24" Foreground="#717970" Margin="8"/></Expander>
   <Expander Header="佈置牠的房間" IsExpanded="True" Margin="0,6,0,18"><StackPanel>
    <WrapPanel><ComboBox x:Name="FurnitureOptions" ItemTemplate="{StaticResource EnumLabel}" Width="150"/><Button Content="放置家具／玩具" Click="AddFurniture"/></WrapPanel>
    <CheckBox x:Name="EditRoom" Content="佈置模式（拖曳家具，右鍵收起）" Checked="EditRoomChanged" Unchecked="EditRoomChanged"/>
    <TextBlock x:Name="RoomStatus" TextWrapping="Wrap" Foreground="#717970" Margin="0,8"/>
   </StackPanel></Expander>
   <Expander Header="聲音" Margin="0,6,0,14"><StackPanel>
    <TextBlock Text="音效包（切換立即套用）"/><ComboBox x:Name="SoundPacks" DisplayMemberPath="Name" SelectionChanged="SelectSoundPack"/>
    <WrapPanel><Button Content="匯入音效包資料夾" Click="ImportSoundPack"/><Button x:Name="RemoveSoundPackButton" Content="移除已匯入音效包" Click="RemoveSoundPack"/></WrapPanel>
    <TextBlock x:Name="SoundPackStatus" TextWrapping="Wrap" Margin="0,6"/>
    <CheckBox x:Name="MuteAudio" Content="靜音" Checked="ChangeAudio" Unchecked="ChangeAudio"/>
    <TextBlock Text="音量（安靜陪伴模式也會靜音）" Margin="0,6"/>
    <Slider x:Name="AudioVolume" Minimum="0" Maximum="100" ValueChanged="ChangeAudio" Width="220" HorizontalAlignment="Left"/>
    <TextBlock Text="貓咪音效"/><Slider x:Name="CatVolume" Minimum="0" Maximum="100" ValueChanged="ChangeAudioCategory" Width="220" HorizontalAlignment="Left"/>
    <TextBlock Text="玩具音效"/><Slider x:Name="ToyVolume" Minimum="0" Maximum="100" ValueChanged="ChangeAudioCategory" Width="220" HorizontalAlignment="Left"/>
    <TextBlock Text="環境音效（目前沒有環境音源）" Foreground="#777777"/><Slider x:Name="AmbientVolume" IsEnabled="False" Minimum="0" Maximum="100" ValueChanged="ChangeAudioCategory" Width="220" HorizontalAlignment="Left"/>
    <WrapPanel><Button Content="試聽貓叫" Click="PreviewCatSound"/><Button Content="試聽呼嚕" Click="PreviewPurrSound"/><Button Content="試聽鈴鐺" Click="PreviewBellSound"/></WrapPanel>
   </StackPanel></Expander>
   <TextBlock Text="顯示與外觀" FontSize="19" Foreground="#426B54"/>
   <TextBlock Text="寵物活動螢幕" Margin="0,8,0,0"/><ComboBox x:Name="DisplayOptions" DisplayMemberPath="Label" SelectionChanged="ChangeDisplay"/>
   <TextBlock x:Name="DisplayStatus" TextWrapping="Wrap" Foreground="#717970"/>
   <TextBlock Text="整體顯示層級（角色、作品與玩具一起套用）" Margin="0,8,0,4"/>
   <ComboBox x:Name="Priorities" ItemTemplate="{StaticResource EnumLabel}" SelectionChanged="ChangePresentation"/>
   <TextBlock Text="低層級位於應用程式下方，視窗還原或最小化即露出桌寵。最高層級受 Windows 獨佔全螢幕與安全桌面限制。" TextWrapping="Wrap" Foreground="#717970" Margin="0,4,0,8"/>
   <CheckBox x:Name="EnableDesktopIcons" Content="允許桌寵移動真實快捷圖示（先備份原始排列）" Foreground="#3E4541" Checked="DesktopIconsChanged" Unchecked="DesktopIconsChanged" Margin="0,4,0,8"/>
   <WrapPanel><Button Content="與快捷圖示互動一次" Click="PlayWithShortcut" Padding="8,4" Margin="0,0,8,0"/><Button Content="更新備份為目前排列" Click="UpdateDesktopIconBackup"/><Button Content="一鍵恢復桌面圖示排列" Click="RestoreDesktopIcons" Padding="8,4"/></WrapPanel>
   <TextBlock x:Name="IconStatus" Text="圖示互動預設關閉；啟用後會備份排列，正常退出時嘗試恢復。" TextWrapping="Wrap" Foreground="#717970" Margin="0,6,0,12"/>
   <TextBlock Text="按主控台右上角 X 時"/><ComboBox x:Name="CloseOptions" ItemTemplate="{StaticResource EnumLabel}" SelectionChanged="ChangeCloseBehavior"/><TextBlock Text="桌寵外觀"/><ComboBox x:Name="Appearances" ItemTemplate="{StaticResource EnumLabel}" SelectionChanged="ChangePresentation" Margin="0,4,0,12"/>
   <Expander Header="進階／診斷" IsExpanded="False" Margin="0,12"><StackPanel>
   <TextBlock x:Name="BrainStatus" Foreground="#426B54" FontSize="16" TextWrapping="Wrap" Margin="0,8"/>
   <TextBlock x:Name="PersonalityStatus" TextWrapping="Wrap" Foreground="#717970" Margin="0,0,0,14"/>
   <Expander Header="習慣與創作偏好"><StackPanel><TextBlock x:Name="ActionScores" TextWrapping="Wrap"/><TextBlock x:Name="StyleStatus" TextWrapping="Wrap"/><TextBlock x:Name="LearningStatus" TextWrapping="Wrap"/><TextBlock x:Name="PreferenceStatus" TextWrapping="Wrap"/></StackPanel></Expander>
   <Separator Margin="0,14"/>
   <TextBlock Text="生理狀態" FontSize="19" Foreground="#426B54"/>
   <TextBlock x:Name="FeedingStatus" Margin="0,8,0,12" TextWrapping="Wrap" Foreground="#717970"/>
   <ItemsControl x:Name="HomeostasisRows"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Value}" Height="7" VerticalAlignment="Center" Foreground="#426B54" Background="#E7E9E0" BorderThickness="0"/><TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:F2}}" HorizontalAlignment="Right" Foreground="#426B54"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="所有值 0–100；飢餓、無聊、孤單、疲勞越高代表需求越高。" Foreground="#717970" TextWrapping="Wrap" Margin="0,10,0,4"/>
   <TextBlock Text="手動行為預覽"/><ComboBox x:Name="Actions" ItemTemplate="{StaticResource EnumLabel}" Width="110" SelectionChanged="SelectAction" Margin="0,0,6,4"/>
   </StackPanel></Expander>
   <TextBlock x:Name="SaveStatus" Text="生理狀態已載入；每 60 秒與正常關閉時保存。" Foreground="#717970" TextWrapping="Wrap"/>
   <Expander Header="存檔與備份" Margin="0,10"><StackPanel>
    <TextBlock x:Name="StorageStatus" TextWrapping="Wrap" Margin="0,6"/>
    <WrapPanel><Button Content="匯出寵物存檔" Click="ExportPetSave"/><Button Content="匯入存檔（下次啟動套用）" Click="ImportPetSave"/></WrapPanel>
   </StackPanel></Expander>
   <Separator Margin="0,14"/>
   <StackPanel Visibility="Collapsed"><TextBlock x:Name="SensorStatus"/><ItemsControl x:Name="SensorRows"/></StackPanel>
   <Separator Margin="0,14"/>
   <TextBlock x:Name="SettingsText" TextWrapping="Wrap" Foreground="#717970"/>
  </StackPanel></ScrollViewer></Border>
  <StackPanel Grid.Row="2"><WrapPanel><Button Content="顯示角色" Click="ShowPet" Padding="8,4" Margin="0,0,6,4"/><Button Content="隱藏角色" Click="HidePet" Padding="8,4" Margin="0,0,6,4"/><Button Content="重設位置" Click="ResetPet" Padding="8,4" Margin="0,0,6,4"/><Button Content="清除作品" Click="ClearArt" Padding="6,4"/><Button Content="保留作品" Click="KeepArt" Padding="6,4"/><Button Content="隱藏／顯示作品" Click="ToggleArt" Padding="6,4"/><Button Content="暫停／恢復自主行為" Click="PauseAi" Padding="6,4"/><Button Content="自動" Click="AutoPet" Padding="8,4" Margin="0,0,6,4"/></WrapPanel><TextBlock x:Name="HitStatus" Text="拖曳可抱起桌寵，放開就落地；輕點給牠摸摸。也可以拖球邀牠玩。" Foreground="#717970" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</Window>









