<Window x:Class="DesktopLife.App.PetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="116" Height="144" WindowStyle="None" AllowsTransparency="True" Background="{x:Null}" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Title="Desktop Life Pet">
 <Window.Resources>
  <LinearGradientBrush x:Key="Fur" StartPoint="0,0" EndPoint=".7,1"><GradientStop Color="#F8CF8B"/><GradientStop Color="#D99049" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="Hair" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#79678A"/><GradientStop Color="#423C5C" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="Dress" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B7DEC6"/><GradientStop Color="#6FAD94" Offset="1"/></LinearGradientBrush>
 </Window.Resources>
 <Canvas x:Name="Surface" Background="{x:Null}">
  <Ellipse Canvas.Left="26" Canvas.Top="134" Width="64" Height="10" Fill="#30000000" IsHitTestVisible="False"/>
  <Grid x:Name="Character" Canvas.Left="0" Canvas.Top="0" Width="116" Height="144" MouseDown="OnPetMouseDown" ToolTip="輕點摸摸，按住可抱起我。">
   <Canvas x:Name="GirlVisual" Width="76" Height="110" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,32,0,0">
    <Ellipse Canvas.Left="7" Canvas.Top="0" Width="62" Height="67" Fill="{StaticResource Hair}"/>
    <Ellipse Canvas.Left="14" Canvas.Top="12" Width="48" Height="47" Fill="#FFD9C2"/>
    <Ellipse Canvas.Left="3" Canvas.Top="27" Width="13" Height="42" Fill="{StaticResource Hair}"/><Ellipse Canvas.Left="60" Canvas.Top="27" Width="13" Height="42" Fill="{StaticResource Hair}"/>
    <Path Data="M 13,20 Q 17,-2 40,8 Q 63,3 65,25 Q 45,26 33,14 Q 27,27 13,27" Fill="{StaticResource Hair}"/>
    <Path Data="M 18,17 Q 24,8 30,11" Stroke="#A496AE" StrokeThickness="3" StrokeStartLineCap="Round"/>
    <Path Data="M 50,19 Q 57,10 60,20 Q 54,27 50,19 M 50,19 Q 44,12 44,23 Q 47,28 50,19" Fill="#F6CDB0"/>
    <Ellipse Canvas.Left="18" Canvas.Top="42" Width="9" Height="4" Fill="#45E39698"/><Ellipse Canvas.Left="51" Canvas.Top="42" Width="9" Height="4" Fill="#45E39698"/>
    <Path Data="M 27,60 Q 38,72 49,60" Stroke="#F7EDCF" StrokeThickness="4"/><Ellipse Canvas.Left="36" Canvas.Top="70" Width="4" Height="4" Fill="#E8BC70"/>
    <TextBlock x:Name="Face" Canvas.Left="23" Canvas.Top="28" Text="• ᴗ •" Foreground="#473C52" FontSize="15"/>
    <Path Data="M 24,59 L 52,59 L 64,92 Q 38,105 12,92 Z" Fill="{StaticResource Dress}"/>
    <Ellipse x:Name="GirlArmL" Canvas.Left="11" Canvas.Top="62" Width="11" Height="24" Fill="#FFD9C2"/><Ellipse x:Name="GirlArmR" Canvas.Left="54" Canvas.Top="62" Width="11" Height="24" Fill="#FFD9C2"/>
    <Rectangle x:Name="GirlLegL" Canvas.Left="23" Canvas.Top="96" Width="10" Height="12" RadiusX="4" RadiusY="4" Fill="{StaticResource Hair}"/><Rectangle x:Name="GirlLegR" Canvas.Left="43" Canvas.Top="96" Width="10" Height="12" RadiusX="4" RadiusY="4" Fill="{StaticResource Hair}"/>
   </Canvas>
   <Canvas x:Name="CatVisual" Visibility="Collapsed">
    <Path x:Name="CatTail" Data="M 59,87 C 86,97 88,65 74,67" Stroke="#CF8C4C" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
    <Ellipse Canvas.Left="14" Canvas.Top="57" Width="49" Height="43" Fill="{StaticResource Fur}" Stroke="#AE733D" StrokeThickness="1"/>
    <Ellipse Canvas.Left="25" Canvas.Top="66" Width="25" Height="28" Fill="#FFF0D4"/>
    <Rectangle x:Name="CatLegL" Canvas.Left="19" Canvas.Top="89" Width="16" Height="18" RadiusX="8" RadiusY="8" Fill="#FFF0D4"/>
    <Rectangle x:Name="CatLegR" Canvas.Left="43" Canvas.Top="89" Width="16" Height="18" RadiusX="8" RadiusY="8" Fill="#FFF0D4"/>
    <Ellipse x:Name="CatArmL" Canvas.Left="12" Canvas.Top="64" Width="13" Height="26" Fill="{StaticResource Fur}"/>
    <Ellipse x:Name="CatArmR" Canvas.Left="52" Canvas.Top="64" Width="13" Height="26" Fill="{StaticResource Fur}"/>
    <Canvas x:Name="CatHead">
     <Path x:Name="CatEarL" Data="M 10,31 Q 4,11 9,7 Q 17,6 29,23 Z" Fill="{StaticResource Fur}" Stroke="#AE733D" StrokeThickness="1.2"/>
     <Path x:Name="CatEarR" Data="M 47,23 Q 60,6 67,7 Q 72,11 66,31 Z" Fill="{StaticResource Fur}" Stroke="#AE733D" StrokeThickness="1.2"/>
     <Path Data="M 13,23 L 12,13 L 24,24 M 52,24 L 64,13 L 63,24" Fill="#E9AF9F"/>
     <Path Data="M 8,36 C 8,11 68,11 69,36 Q 76,60 40,65 Q 2,63 8,36" Fill="{StaticResource Fur}" Stroke="#AE733D" StrokeThickness="1.2"/>
     <Path Data="M 29,21 L 32,28 M 38,20 L 38,29 M 47,21 L 44,28" Stroke="#B8773C" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
     <Ellipse Canvas.Left="21" Canvas.Top="42" Width="35" Height="19" Fill="#FFF0D4"/>
     <Canvas x:Name="CatEyes">
      <Ellipse Canvas.Left="22" Canvas.Top="33" Width="9" Height="12" Fill="#425D4B"/><Ellipse Canvas.Left="47" Canvas.Top="33" Width="9" Height="12" Fill="#425D4B"/>
      <Ellipse Canvas.Left="25" Canvas.Top="34" Width="4" Height="9" Fill="#293D35"/><Ellipse Canvas.Left="49" Canvas.Top="34" Width="4" Height="9" Fill="#293D35"/>
      <Ellipse Canvas.Left="24" Canvas.Top="34" Width="3" Height="3" Fill="#FFFFFF"/><Ellipse Canvas.Left="49" Canvas.Top="34" Width="3" Height="3" Fill="#FFFFFF"/>
     </Canvas>
     <Path x:Name="CatClosedEyes" Data="M 22,39 Q 26,34 31,39 M 46,39 Q 51,34 56,39" Stroke="#584936" StrokeThickness="2" Visibility="Collapsed"/>
     <Path Data="M 35,46 Q 38,44 42,46 L 38,50 Z" Fill="#BA7F76"/>
     <Path Data="M 38,50 Q 34,56 30,51 M 38,50 Q 42,56 46,51" Stroke="#795B49" StrokeThickness="1.3"/>
     <Ellipse Canvas.Left="14" Canvas.Top="44" Width="9" Height="4" Fill="#55E39B8A"/><Ellipse Canvas.Left="55" Canvas.Top="44" Width="9" Height="4" Fill="#55E39B8A"/>
     <Path Data="M 3,42 L 18,46 M 3,51 L 18,49 M 58,46 L 73,42 M 58,49 L 73,51" Stroke="#98724E" StrokeThickness="1"/>
    </Canvas>
    <Path Data="M 22,62 Q 38,68 56,62 L 46,76 L 38,70 L 32,76 Z" Fill="#709B82"/>
    <Ellipse Canvas.Left="35" Canvas.Top="65" Width="7" Height="7" Fill="#ECCB82" Stroke="#BB9253" StrokeThickness=".7"/>
    <TextBlock x:Name="CatFace" Visibility="Collapsed"/>
   </Canvas>
   <Canvas x:Name="SleepingCat" Visibility="Collapsed">
    <Ellipse Canvas.Left="7" Canvas.Top="62" Width="65" Height="39" Fill="{StaticResource Fur}" Stroke="#AE733D"/>
    <Path Data="M 23,75 Q 6,57 13,51 L 30,67 M 35,66 L 46,50 Q 54,51 48,75" Fill="{StaticResource Fur}" Stroke="#AE733D"/>
    <Ellipse Canvas.Left="10" Canvas.Top="66" Width="43" Height="29" Fill="{StaticResource Fur}"/>
    <Path Data="M 17,78 Q 22,82 27,78 M 33,78 Q 38,82 43,78" Stroke="#665039" StrokeThickness="1.5"/>
    <Path Data="M 28,85 L 33,85 L 30,88 Z" Fill="#BA7F76"/>
    <Path Data="M 67,83 Q 65,106 25,96" Stroke="#D59B5A" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
   </Canvas>
  </Grid>
  <Path x:Name="ToyPaw" Data="M 78,125 Q 99,114 110,130" Stroke="#EEBF7C" StrokeThickness="10" StrokeEndLineCap="Round" Visibility="Collapsed" IsHitTestVisible="False"/>
  <Canvas x:Name="GroomComb" Canvas.Left="87" Canvas.Top="66" Visibility="Collapsed" IsHitTestVisible="False">
   <Path Data="M 0,0 L 15,13 M 2,5 L -3,10 M 5,8 L 0,13 M 8,11 L 3,16 M 11,14 L 6,19" Stroke="#697F78" StrokeThickness="3" StrokeStartLineCap="Round"/><Path Data="M 15,13 L 22,21" Stroke="#C99370" StrokeThickness="5" StrokeEndLineCap="Round"/>
  </Canvas>
  <Canvas x:Name="PettingHand" Canvas.Left="42" Canvas.Top="19" Visibility="Collapsed" IsHitTestVisible="False">
   <Path Data="M 12,1 Q 15,-2 18,2 L 18,10 L 32,13 Q 37,17 32,21 L 13,21 Q 7,19 6,13 L 2,9 Q 1,4 6,6 L 11,10 Z" Fill="#F2CFB5" Stroke="#C4977F" StrokeThickness="1"/><Path Data="M 13,22 L 31,22 L 32,29 L 13,29 Z" Fill="#7F9F94"/>
  </Canvas>
  <Canvas x:Name="FoodBowl" Visibility="Collapsed" IsHitTestVisible="False"><Ellipse Canvas.Left="39" Canvas.Top="126" Width="39" Height="13" Fill="#C98F57"/><Path Data="M 37,129 L 80,129 L 74,140 Q 58,145 43,139 Z" Fill="#87AA9B"/><Ellipse Canvas.Left="49" Canvas.Top="127" Width="6" Height="4" Fill="#81583B"/><Ellipse Canvas.Left="60" Canvas.Top="128" Width="6" Height="4" Fill="#81583B"/></Canvas>
  <TextBlock x:Name="Affection" Canvas.Left="83" Canvas.Top="28" Text="♥" Foreground="#D9898C" FontSize="20" Visibility="Collapsed" IsHitTestVisible="False"/>
  <Border x:Name="SpeechBubble" Canvas.Left="2" Canvas.Top="0" MaxWidth="112" Background="#F8FFFAEF" BorderBrush="#DDCFB8" BorderThickness="1" CornerRadius="8" Padding="5,3" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="SpeechText" TextWrapping="Wrap" FontSize="11" Foreground="#4F5D4D" TextAlignment="Center"/></Border>
  <TextBlock x:Name="SleepMark" Canvas.Left="77" Canvas.Top="47" Text="呼…" FontSize="15" Foreground="#16765E" Visibility="Collapsed" IsHitTestVisible="False"/>
  <Path x:Name="Pencil" Canvas.Left="77" Canvas.Top="77" Data="M 0,0 L 12,23" Stroke="#E2A728" StrokeThickness="4" Visibility="Collapsed" IsHitTestVisible="False"/>
  <TextBlock x:Name="ActionLabel" Canvas.Left="7" Canvas.Top="0" Foreground="#16765E" FontWeight="Bold" FontSize="12" Visibility="Collapsed" IsHitTestVisible="False"/>
 </Canvas>
</Window>

